FROM eclipse-temurin:11-jre-alpine

ARG SENTINEL_VERSION=1.8.9
WORKDIR /app

RUN apk add --no-cache wget \
 && wget -q -O /app/app.jar "https://github.com/alibaba/Sentinel/releases/download/${SENTINEL_VERSION}/sentinel-dashboard-${SENTINEL_VERSION}.jar" \
 && test -s /app/app.jar

RUN addgroup -S app && adduser -S app -G app && chown -R app:app /app
USER app

EXPOSE 8858

ENTRYPOINT ["sh", "-c", "exec java -Dserver.port=8858 -Dcsp.sentinel.dashboard.server=localhost:8858 -Dproject.name=sentinel-dashboard -Dserver.servlet.session.timeout=7200 -Dcsp.sentinel.log.use.pid=true -jar /app/app.jar"]
